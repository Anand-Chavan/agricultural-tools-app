generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  stockMovements   StockMovement[]
  purchases        Purchase[]      @relation("PurchaseCreator")
  supplierPayments SupplierPayment[]
  invoices         Invoice[]       @relation("InvoiceCreator")
  customerPayments CustomerPayment[]
  saleReturns      SaleReturn[]
  auditLogs        AuditLog[]
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  businessName    String?
  taxId           String?
  notes           String?
  isActive        Boolean   @default(true)
  isWalkIn        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]

  @@index([phone])
  @@index([name])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxId       String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]

  @@index([name])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TaxRate {
  id            String    @id @default(cuid())
  name          String
  rate          Decimal   @db.Decimal(8, 4)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum ProductType {
  MANUFACTURED
  RESOLD
}

model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  productType   ProductType    @default(MANUFACTURED)
  description   String?
  unit          String         @default("pcs")
  costPrice     Decimal        @db.Decimal(12, 2)
  sellingPrice  Decimal        @db.Decimal(12, 2)
  taxRateId     String?
  taxRate       TaxRate?       @relation(fields: [taxRateId], references: [id])
  reorderLevel  Decimal        @default(0) @db.Decimal(12, 3)
  barcode       String?
  material      String?
  dimensions    String?
  weight        String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]
  stockBalances StockBalance[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  invoiceItems  InvoiceItem[]
  returnItems   SaleReturnItem[]

  @@index([name])
  @@index([barcode])
  @@index([isActive])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model StockBalance {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  locationId     String?
  quantityOnHand Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
}

enum MovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE_WRITE_OFF
  MANUAL_ADJUSTMENT
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  movementType  MovementType
  quantityDelta Decimal      @db.Decimal(14, 3)
  unitCost      Decimal?     @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  reason        String?
  createdById   String?
  createdBy     User?        @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum PurchaseStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id                    String           @id @default(cuid())
  purchaseNumber        String           @unique
  supplierId            String
  supplier              Supplier         @relation(fields: [supplierId], references: [id])
  supplierInvoiceNumber String?
  status                PurchaseStatus   @default(DRAFT)
  purchaseDate          DateTime         @default(now())
  subtotal              Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal          @default(0) @db.Decimal(14, 2)
  otherCharges          Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal            Decimal          @default(0) @db.Decimal(14, 2)
  amountPaid            Decimal          @default(0) @db.Decimal(14, 2)
  balanceDue            Decimal          @default(0) @db.Decimal(14, 2)
  notes                 String?
  createdById           String?
  createdBy             User?            @relation("PurchaseCreator", fields: [createdById], references: [id])
  receivedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  items                 PurchaseItem[]
  payments              SupplierPayment[]

  @@index([status])
  @@index([purchaseDate])
  @@index([supplierId])
}

model PurchaseItem {
  id               String   @id @default(cuid())
  purchaseId       String
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantityOrdered  Decimal  @db.Decimal(14, 3)
  quantityReceived Decimal  @default(0) @db.Decimal(14, 3)
  unitCost         Decimal  @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  taxRateSnapshot  Decimal  @default(0) @db.Decimal(8, 4)
  lineTotal        Decimal  @db.Decimal(14, 2)
}

model SupplierPayment {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  method      String
  reference   String?
  paidAt      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  UNPAID
  VOIDED
  REFUNDED
}

model Invoice {
  id             String          @id @default(cuid())
  invoiceNumber  String?         @unique
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  walkInName     String?
  status         InvoiceStatus   @default(DRAFT)
  invoiceDate    DateTime        @default(now())
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal         @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal         @default(0) @db.Decimal(14, 2)
  balanceDue     Decimal         @default(0) @db.Decimal(14, 2)
  notes          String?
  createdById    String?
  createdBy      User?           @relation("InvoiceCreator", fields: [createdById], references: [id])
  issuedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          InvoiceItem[]
  payments       CustomerPayment[]
  returns        SaleReturn[]

  @@index([status])
  @@index([invoiceDate])
  @@index([customerId])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id                 String   @id @default(cuid())
  invoiceId          String
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  skuSnapshot        String
  productNameSnapshot String
  quantity           Decimal  @db.Decimal(14, 3)
  unitPrice          Decimal  @db.Decimal(12, 2)
  unitCostSnapshot   Decimal? @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  taxRateSnapshot    Decimal  @default(0) @db.Decimal(8, 4)
  taxAmount          Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(14, 2)
}

model CustomerPayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  method      String
  reference   String?
  paidAt      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model SaleReturn {
  id           String           @id @default(cuid())
  returnNumber String           @unique
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id])
  status       ReturnStatus     @default(COMPLETED)
  reason       String
  restock      Boolean          @default(true)
  subtotal     Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal          @default(0) @db.Decimal(14, 2)
  total        Decimal          @default(0) @db.Decimal(14, 2)
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  items        SaleReturnItem[]
}

model SaleReturnItem {
  id            String     @id @default(cuid())
  saleReturnId  String
  saleReturn    SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  invoiceItemId String?
  quantity      Decimal    @db.Decimal(14, 3)
  unitPrice     Decimal    @db.Decimal(12, 2)
  taxAmount     Decimal    @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal    @db.Decimal(14, 2)
}

model BusinessSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

model InvoiceSequence {
  id        String @id @default("default")
  prefix    String @default("INV")
  nextNumber Int   @default(1)
}
